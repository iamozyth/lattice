# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

POSTGRES_USER=lattice
POSTGRES_DB=lattice
POSTGRES_PASSWORD=
SECRET_KEY=
CONNECTOR_SECRET=

# Host port for the web UI
WEB_PORT=5001

# Optional
# SCAN_INTERVAL_HOURS=6   # 0 turns scheduled ping sweeps off
# STALE_DAYS=30
# COOKIE_SECURE=true      # when served over HTTPS
# TRUST_PROXY=true        # behind a reverse proxy
